# ==============================================================================
# NovaConnect Telecoms Conversational IVR — environment template
# ------------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Every key below maps to a field on app/core/config.py::Settings.
# ==============================================================================

# -- Required ------------------------------------------------------------------
# Sarvam AI subscription key. The only provider secret: it backs speech-to-text,
# the chat-completions text brain, and text-to-speech alike.
SARVAM_API_KEY=your_sarvam_api_key_here

# -- Operator access -----------------------------------------------------------
# Comma-separated keys authorized for operator endpoints (subscriber records,
# telemetry, session transcripts). These endpoints expose caller names, phone
# numbers, balances, and what people said, so they are CLOSED BY DEFAULT: leave
# this empty and they reject every request rather than serving them openly.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_API_KEYS=

# -- State backend -------------------------------------------------------------
# Redis connection URL. Without it the engine keeps sessions, telemetry, and
# subscriber records in process memory — which is fine locally, but means state
# is lost on restart and NOT shared between workers. The engine refuses to boot
# with more than one worker unless this is set.
REDIS_URL=
SESSION_TTL_SECONDS=1800
TELEMETRY_HISTORY_SIZE=200

# -- Frontend origin -----------------------------------------------------------
# Comma-separated origins allowed to call this API from a browser. Empty means
# same-origin only. '*' is rejected — explicit origins only.
# e.g. http://localhost:3000,https://console.example.com
CORS_ALLOW_ORIGINS=http://localhost:3000

# -- Models (optional; defaults live in app/core/config.py) ---------------------
# SARVAM_TEXT_MODEL=sarvam-105b-conversations
# STT_MODEL=saaras:v3
# TTS_MODEL=bulbul:v3
# TTS_SPEAKER=priya          # must be valid for TTS_MODEL; checked at boot

# Speak the reply in whatever language STT detected, rather than always using
# TTS_TARGET_LANGUAGE_CODE. Turn off only if you want every reply in one voice.
# TTS_FOLLOW_DETECTED_LANGUAGE=true
# TTS_TARGET_LANGUAGE_CODE=en-IN

# -- Conversation discipline ---------------------------------------------------
# REPLY_MAX_WORDS=30
# REPLY_HARD_MAX_WORDS=50
# MAX_HISTORY_TURNS=12

# -- Resilience & limits -------------------------------------------------------
# SARVAM_MAX_RETRIES=2
# MAX_AUDIO_UPLOAD_BYTES=10485760
# RATE_LIMIT_TURNS_PER_MINUTE=20

# -- Server --------------------------------------------------------------------
# APP_ENV=production
# LOG_LEVEL=INFO
# LOG_FORMAT=json          # 'console' is easier to read locally
# HOST=0.0.0.0
# PORT=8000
