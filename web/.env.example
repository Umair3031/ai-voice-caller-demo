# ==============================================================================
# NovaConnect Telecoms IVR — frontend environment
# ------------------------------------------------------------------------------
# Copy to `.env.local`. Neither value is exposed to the browser: every engine
# call goes through this app's /api/engine proxy, which runs on the server.
# ==============================================================================

# Where the FastAPI engine lives.
ENGINE_BASE_URL=http://localhost:8000

# One key from the engine's OPERATOR_API_KEYS. Server-only — the proxy attaches
# it to operator requests so it never reaches a browser bundle. Do NOT prefix
# this with NEXT_PUBLIC_.
OPERATOR_API_KEY=
